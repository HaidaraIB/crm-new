# CRM web app — copy to .env and fill in values (see README)

# JSON API root (recommended: /api/v1). No trailing slash.
# Examples: http://127.0.0.1:8000/api/v1   https://api.example.com/api/v1
VITE_API_URL=http://127.0.0.1:8000/api/v1

# Must match API_KEY_WEB on the Django API (X-API-Key header for protected /api/* routes).
VITE_API_KEY_WEB=

# Optional fallback if you still use the old variable name
# VITE_API_KEY=

# Optional: subdomain routing (see utils/routing.ts)
# VITE_BASE_DOMAIN=dashboard.loop-crm.app

# Optional: Gemini
# GEMINI_API_KEY=

# ---------------------------------------------------------------------------
# Realtime channel (WebSocket)
# ---------------------------------------------------------------------------
# Off by default. Turn on only after crm-realtime.service is running and nginx
# routes /ws/ (see CRM-api-1/docs/REALTIME.md). With it off the app polls the
# sync digest every 5s, exactly as it did before.
# VITE_REALTIME_ENABLED=true

# Optional. Derived from VITE_API_URL when unset (https://host/api/v1 -> wss://host/ws/sync/).
# VITE_REALTIME_URL=wss://api.example.com/ws/sync/

# ---------------------------------------------------------------------------
# Web push (optional)
# ---------------------------------------------------------------------------
# Reaches the user when no tab is open — the realtime socket only covers an open
# tab. Leave blank to disable entirely; the app no-ops without these.
#
# All six come from Firebase console > Project settings > General > Your apps >
# Web app. They are public identifiers, not secrets, and ship in the client
# bundle. Use the SAME Firebase project as the mobile app, or the server's
# credentials will not be able to send to these tokens.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
#
# Firebase console > Project settings > Cloud Messaging > Web Push certificates
# > "Key pair". Web push does not work without it.
# VITE_FIREBASE_VAPID_KEY=
